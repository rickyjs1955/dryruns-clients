# dryruns.tools environment — copy to .env.local and fill in.
# This file lists variable NAMES only. Never commit real secrets.

# Base URL of the budgetary.tools hosted estimate API.
# Example: https://api.budgetary.tools
BUDGETARY_API_BASE=

# Server-side secret. Used only by the proxy route (app/api/estimate/route.ts).
# The browser must never see this value. Do NOT prefix with NEXT_PUBLIC_.
BUDGETARY_API_KEY=

# Project that identifies the indexed codebase to estimate against (sent as
# context.project_id). Without it the API returns out_of_domain/void for every
# task. Server-side config — not a secret, but kept out of the client.
BUDGETARY_PROJECT_ID=

# Optional: exploration depth hint for the estimate (sent as
# context.depth_budget). Non-negative integer. Leave unset for the API default.
BUDGETARY_DEPTH_BUDGET=

# Optional kill switch. Set to "1" or "true" to disable estimate requests
# (the proxy returns a friendly 503). Leave unset to keep the demo live.
DRYRUNS_DISABLED=

# Optional: max estimate requests allowed per IP per minute (default 12).
DRYRUNS_RATE_LIMIT_PER_MIN=
